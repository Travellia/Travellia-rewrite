# ---------------------------------------------------------------------------
# SMTP — form notification emails (Google / Gmail)
# ---------------------------------------------------------------------------
# The Gmail account that authenticates. This is also the From address, because
# Gmail rewrites From to the authenticated account unless the address is a
# verified "send as" alias on it.
USER_EMAIL=shazibarbazbasit@gmail.com

# A Google APP PASSWORD for the account above — not its normal password.
#   Google Account > Security > 2-Step Verification > App passwords
# 2-Step Verification must be ON before app passwords can be generated.
# Google displays it as "abcd efgh ijkl mnop"; pasting the spaces is fine,
# they are stripped automatically.
USER_APP_PASSWORD=

# Where the notifications are delivered.
MAIL_TO=inquiries@travellia.co.uk

# Optional. Defaults to USER_EMAIL. Only set this to an address Gmail has
# verified as a "send as" alias, otherwise Gmail silently rewrites it back
# to USER_EMAIL and the header will not say what you expect.
# MAIL_FROM=shazibarbazbasit@gmail.com

# Optional. Defaults to Gmail. Port 465 is implicit TLS, 587 is STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ---------------------------------------------------------------------------
# ntfy.sh — push notification mirror of the same content
# ---------------------------------------------------------------------------
NTFY_URL=https://ntfy.sh
# NOTE: a public ntfy.sh topic is readable by anyone who guesses the name.
# Move to a protected topic + NTFY_TOKEN before this carries real customer data.
NTFY_TOPIC=travellia-forms-8f3d21
NTFY_TOKEN=
